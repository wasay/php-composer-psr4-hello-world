{
  "name": "wasaysyed/php-psr4-basic",
  "description": "A minimal, dependency-free example of Composer PSR-4 autoloading in PHP.",
  "keywords": [
    "php",
    "composer",
    "psr-4",
    "autoloading",
    "tutorial",
    "example"
  ],
  "require": {
    "php": ">=8.1"
  },
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Wasay Syed",
      "email": "i@wasaysyed.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "archive": {
    "exclude": [
      "vendor",
      ".DS_Store",
      "*.log"
    ]
  }
}
